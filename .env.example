# Copy to .env (`make up` does this for you). .env is gitignored.
#
# Variables parsed and validated in internal/platform/config.
#
# A name that appears here but not there is ignored.
#
# A bad value fails the process at startup rather than at first use.

# --- app ---------------------------------------------------------------
# Port the app is published on for the host. Compose-only: the app inside the
# container always listens on 8080.
HTTP_PORT=8080

# Address the app listens on. Leave unset under compose — the port mapping
# above assumes 8080 inside the container.
# HTTP_ADDR=:8080

# How long in-flight requests get to finish after SIGTERM.
# HTTP_SHUTDOWN_GRACE=10s

# The timezone the business runs on.
# Must be an IANA name.
# Must be explicitly stated rather than inherited from the host; "Local" is rejected.
BUSINESS_TZ=Europe/Moscow

# --- session -----------------------------------------------------------
# A key the login cookie is signed with. At least 32 characters.
#
#   openssl rand -base64 32
#
# If left unset, then one is generated at boot and sessions last until the process
# restarts.
#
# SESSION_SECRET=

# How long a login lasts. Default is a week.
# SESSION_TTL=168h

# --- logging -----------------------------------------------------------
# debug | info | warn | error, optionally with an offset such as warn+2.
LOG_LEVEL=info

# text reads well in a terminal; json is for a log collector.
LOG_FORMAT=text

# --- postgres ----------------------------------------------------------
POSTGRES_USER=pilam
POSTGRES_PASSWORD=pilam
POSTGRES_DB=pilam

# Port Postgres is published on for the host, so you can psql from your
# machine. Nothing inside compose uses it — the app reaches the database
# as db:5432 over the compose network.
POSTGRES_PORT=5433

# The compose network. Running the app on the host instead (`make run`) with no
# DATABASE_URL set falls back to localhost:5433, which is the stack above.
DATABASE_URL=postgres://pilam:pilam@db:5432/pilam?sslmode=disable

# --- media -------------------------------------------------------------
# Colorway photos. Backed by a named volume in compose. Relative paths are
# resolved against the working directory; the default is ./tmp/media.
MEDIA_DIR=/var/lib/pilam/media
