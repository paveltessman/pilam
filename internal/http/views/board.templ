package views

import "github.com/paveltessman/pilam/internal/platform/labels"

// Board is the post-login destination.
templ Board(chrome Chrome) {
	{{ chrome.Current = labels.NavBoard }}
	@Page(labels.NavBoard, chrome) {
		<main class="mx-auto w-full max-w-5xl px-6 py-16">
			<div class="rounded-lg border border-dashed p-12 text-center text-muted-foreground">
				<p>Сезон пока пуст.</p>
			</div>
		</main>
	}
}
