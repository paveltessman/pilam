package views

import (
	"github.com/paveltessman/pilam/internal/audit"
	"github.com/paveltessman/pilam/internal/auth"
	"github.com/paveltessman/pilam/internal/http/views/ui/button"
	"github.com/paveltessman/pilam/internal/http/views/ui/input"
	"github.com/paveltessman/pilam/internal/platform/labels"
	"github.com/paveltessman/pilam/internal/platform/validate"
)

const (
	FieldUserFirstName = "first_name"
	FieldUserLastName  = "last_name"
	FieldUserRole      = "role"
	FieldUserActive    = "active"
	FieldUserSearch    = "q"
)

// usersResults is the element the search swaps. The list renders it, and a
// search request answers with what goes inside it.
const usersResults = "users-results"

// UsersPath is where the section is mounted. The links and the forms of this
// screen build on it, and the router mounts the section on it.
const UsersPath = "/users"

// roleOptions is the role select, in the order it is offered.
var roleOptions = []auth.Role{auth.MemberRole, auth.RootRole}

// UsersPage is the list: every user the search keeps, active and inactive.
// Query is what the user typed, and an empty Query lists everybody.
type UsersPage struct {
	Chrome Chrome
	Users  []auth.Account
	Query  string
}

// EmptyText tells the two empty lists apart: a section that holds no users, and
// a search that matches none of them.
func (p UsersPage) EmptyText() string {
	if p.Query != "" {
		return labels.UsersNoMatch
	}
	return labels.UsersEmpty
}

templ Users(page UsersPage) {
	{{ page.Chrome.Current = labels.UsersTitle }}
	@Page(labels.UsersTitle, page.Chrome) {
		<main class="mx-auto w-full max-w-5xl px-6 py-10">
			<div class="mb-6 flex items-center gap-4">
				<h1 class="text-2xl font-semibold tracking-tight">{ labels.UsersTitle }</h1>
				@button.Button(button.Props{Href: UsersPath + "/new", Size: button.SizeSm, Class: "ml-auto"}) {
					{ labels.ActionAddUser }
				}
			</div>
			@usersSearch(page.Query)
			<div id={ usersResults }>
				@UsersResults(page)
			</div>
		</main>
	}
}

// usersSearch is the box above the list. htmx swaps the table as the user
// types. Without htmx the form still works: it posts nothing, it submits the
// same GET the links use, and the page comes back filtered.
templ usersSearch(query string) {
	<form method="get" action={ templ.SafeURL(UsersPath) } role="search" class="mb-4">
		@input.Input(input.Props{
			ID:          FieldUserSearch,
			Name:        FieldUserSearch,
			Type:        input.TypeSearch,
			Value:       query,
			Placeholder: labels.UsersSearchHint,
			Attributes: templ.Attributes{
				"aria-label":   labels.UsersSearch,
				"autocomplete": "off",
				"hx-get":       UsersPath,
				"hx-trigger":   "input changed delay:250ms, search",
				"hx-target":    "#" + usersResults,
				"hx-swap":      "innerHTML",
				"hx-push-url":  "true",
			},
		})
	</form>
}

// UsersResults is the table alone. The full page renders it inside the list,
// and a search request answers with it and nothing else.
templ UsersResults(page UsersPage) {
	if len(page.Users) == 0 {
		<div class="rounded-lg border border-dashed p-12 text-center text-muted-foreground">
			<p>{ page.EmptyText() }</p>
		</div>
	} else {
		<div class="overflow-x-auto rounded-lg border">
			<table class="w-full text-sm">
				<thead class="border-b bg-muted/50 text-left text-muted-foreground">
					<tr>
						<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersName }</th>
						<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersEmail }</th>
						<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersRole }</th>
						<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersState }</th>
						<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersLastChange }</th>
					</tr>
				</thead>
				<tbody>
					for _, account := range page.Users {
						@userRow(account)
					}
				</tbody>
			</table>
		</div>
	}
}

templ userRow(account auth.Account) {
	<tr class="border-b last:border-0 hover:bg-muted/50">
		<td class="px-4 py-3">
			<a href={ templ.SafeURL(UsersPath + "/" + account.ID.String()) } class="font-medium underline-offset-4 hover:underline">
				{ labels.Name(account.FirstName, account.LastName) }
			</a>
		</td>
		<td class="px-4 py-3">{ account.Email }</td>
		<td class="px-4 py-3">{ roleLabel(account.Role) }</td>
		<td class="px-4 py-3">
			if account.Active {
				<span class="text-muted-foreground">{ labels.UsersActive }</span>
			} else {
				<span class="text-destructive">{ labels.UsersInactive }</span>
			}
		</td>
		<td class="px-4 py-3 text-muted-foreground">{ labels.Date(account.UpdatedAt) }</td>
	</tr>
}

// UserForm is the create screen and the edit screen. They differ in what the
// user may change: a new user is given an address, and an existing one keeps
// the address they log in with.
//
// Alert carries a refusal that belongs to the form rather than to one field.
type UserForm struct {
	Chrome    Chrome
	UserID    string
	Email     string
	FirstName string
	LastName  string
	Role      auth.Role
	Active    bool
	Alert     string
	Errors    validate.FieldErrors

	// Trail is what the audit log holds about this user, newest first. The
	// create screen has none, because the user is not there yet.
	Trail []UserEvent
}

// IsNew reports whether the form creates a user rather than editing one.
func (f UserForm) IsNew() bool { return f.UserID == "" }

// Action is where the form posts.
func (f UserForm) Action() string {
	if f.IsNew() {
		return UsersPath
	}
	return UsersPath + "/" + f.UserID
}

func (f UserForm) Title() string {
	if f.IsNew() {
		return labels.UsersNewTitle
	}
	return labels.UsersEditTitle
}

// UserEvent is one entry of the audit trail as the card shows it: the change
// the trail recorded, and the user who made it.
type UserEvent struct {
	Entry audit.Entry
	Actor auth.Account
}

// When is the moment of the change. The log stamps it in the business timezone.
func (e UserEvent) When() string { return labels.DateTime(e.Entry.At) }

// Who names the actor. Every entry names one, so an account with no address
// means the trail points at a user the store no longer holds.
func (e UserEvent) Who() string {
	if e.Actor.Email == "" {
		return labels.Empty
	}
	return labels.Name(e.Actor.FirstName, e.Actor.LastName)
}

// What reads the change: the action, and the two values it moved between where
// those add anything to the action.
func (e UserEvent) What() string {
	action := auditAction(e.Entry)
	old, next := auditValue(e.Entry.FieldKey, e.Entry.Old), auditValue(e.Entry.FieldKey, e.Entry.New)

	switch {
	case old != "" && next != "":
		return action + ": " + old + " → " + next
	case next != "":
		return action + ": " + next
	}
	return action
}

templ User(form UserForm) {
	{{ messages := labels.Messages(form.Errors) }}
	{{ form.Chrome.Current = labels.UsersTitle }}
	@Page(form.Title(), form.Chrome) {
		<main class="mx-auto w-full max-w-xl px-6 py-10">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">{ form.Title() }</h1>
			if form.Alert != "" {
				<p role="alert" class="mb-6 rounded-md border border-destructive/50 px-3 py-2 text-sm text-destructive">
					{ form.Alert }
				</p>
			}
			<form method="post" action={ templ.SafeURL(form.Action()) } class="space-y-5 rounded-lg border bg-card p-6 text-card-foreground">
				@formField(fieldProps{Name: FieldEmail, Label: labels.UsersEmail, Message: messages[FieldEmail]}) {
					if form.IsNew() {
						@input.Input(input.Props{
							ID:         FieldEmail,
							Name:       FieldEmail,
							Type:       input.TypeEmail,
							Value:      form.Email,
							HasError:   messages[FieldEmail] != "",
							Attributes: templ.Attributes{"autocomplete": "off", "autofocus": true},
						})
					} else {
						@input.Input(input.Props{ID: FieldEmail, Type: input.TypeEmail, Value: form.Email, Readonly: true})
					}
				}
				@formField(fieldProps{Name: FieldUserFirstName, Label: labels.UsersFirstName, Message: messages[FieldUserFirstName]}) {
					@input.Input(input.Props{
						ID:       FieldUserFirstName,
						Name:     FieldUserFirstName,
						Value:    form.FirstName,
						HasError: messages[FieldUserFirstName] != "",
					})
				}
				@formField(fieldProps{Name: FieldUserLastName, Label: labels.UsersLastName, Message: messages[FieldUserLastName]}) {
					@input.Input(input.Props{
						ID:       FieldUserLastName,
						Name:     FieldUserLastName,
						Value:    form.LastName,
						HasError: messages[FieldUserLastName] != "",
					})
				}
				@formField(fieldProps{Name: FieldUserRole, Label: labels.UsersRole, Message: messages[FieldUserRole]}) {
					@roleSelect(form.Role, messages[FieldUserRole] != "")
				}
				if !form.IsNew() {
					<label class="flex items-center gap-2 text-sm font-medium">
						<input
							type="checkbox"
							id={ FieldUserActive }
							name={ FieldUserActive }
							value="true"
							checked?={ form.Active }
							class="size-4 rounded border border-input accent-primary"
						/>
						{ labels.UsersActive }
					</label>
				}
				@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
					{ labels.ActionSave }
				}
			</form>
			<div class="mt-4 flex items-center gap-3">
				@button.Button(button.Props{Href: UsersPath, Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ labels.ActionBackToList }
				}
				if !form.IsNew() {
					<form method="post" action={ templ.SafeURL(form.Action() + "/password") } class="ml-auto">
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ labels.ActionResetPasswd }
						}
					</form>
				}
			</div>
			if !form.IsNew() {
				@userAudit(form.Trail)
			}
		</main>
	}
}

// userAudit is the history of one user, newest first. It reads what the trail
// recorded, and it changes nothing.
templ userAudit(events []UserEvent) {
	<section class="mt-10">
		<h2 class="mb-4 text-lg font-semibold tracking-tight">{ labels.UsersAuditTitle }</h2>
		if len(events) == 0 {
			<div class="rounded-lg border border-dashed p-6 text-center text-sm text-muted-foreground">
				<p>{ labels.UsersAuditEmpty }</p>
			</div>
		} else {
			<div class="overflow-x-auto rounded-lg border">
				<table class="w-full text-sm">
					<thead class="border-b bg-muted/50 text-left text-muted-foreground">
						<tr>
							<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersAuditWhen }</th>
							<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersAuditWho }</th>
							<th scope="col" class="px-4 py-3 font-medium">{ labels.UsersAuditWhat }</th>
						</tr>
					</thead>
					<tbody>
						for _, event := range events {
							<tr class="border-b last:border-0">
								<td class="px-4 py-3 whitespace-nowrap text-muted-foreground">{ event.When() }</td>
								<td class="px-4 py-3">{ event.Who() }</td>
								<td class="px-4 py-3">{ event.What() }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ roleSelect(current auth.Role, hasError bool) {
	<select
		id={ FieldUserRole }
		name={ FieldUserRole }
		if hasError {
			aria-invalid="true"
			class="flex h-9 w-full rounded-md border border-destructive bg-transparent px-3 py-1 text-base shadow-xs outline-none md:text-sm"
		} else {
			class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] md:text-sm"
		}
	>
		for _, role := range roleOptions {
			<option value={ string(role) } selected?={ role == current }>{ roleLabel(role) }</option>
		}
	</select>
}

// UserPasswdPage shows a first password once. Nothing stores the plain text, so
// this render is the only place it is ever readable.
type UserPasswdPage struct {
	Chrome Chrome
	Title  string
	Email  string
	Name   string
	Passwd string
}

templ UserPasswd(page UserPasswdPage) {
	{{ page.Chrome.Current = labels.UsersTitle }}
	@Page(page.Title, page.Chrome) {
		<main class="mx-auto w-full max-w-xl px-6 py-10">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">{ page.Title }</h1>
			<div class="space-y-4 rounded-lg border bg-card p-6 text-card-foreground">
				<p class="text-sm text-muted-foreground">{ page.Name } · { page.Email }</p>
				<p role="alert" class="rounded-md border border-primary/50 px-3 py-2 text-sm text-center">
					{ labels.UsersPasswdOnce }
				</p>
				<code class="block rounded-md border bg-muted px-3 py-2 font-mono text-lg break-all select-all">
					{ page.Passwd }
				</code>
				<p class="text-sm text-muted-foreground">{ labels.UsersPasswdChange }</p>
			</div>
			<div class="mt-4">
				@button.Button(button.Props{Href: UsersPath, Size: button.SizeSm}) {
					{ labels.ActionBackToList }
				}
			</div>
		</main>
	}
}

// auditAction is the one place a recorded action becomes a phrase the user
// reads. A name change also states which of the two names moved.
func auditAction(entry audit.Entry) string {
	switch entry.Action {
	case audit.ActionCreated:
		return labels.UsersAuditCreated
	case audit.ActionNameChanged:
		if entry.FieldKey == auth.FieldLastName {
			return labels.UsersAuditLastName
		}
		return labels.UsersAuditFirstName
	case audit.ActionRoleChanged:
		return labels.UsersAuditRole
	case audit.ActionDeactivated:
		return labels.UsersAuditOff
	case audit.ActionReactivated:
		return labels.UsersAuditOn
	case audit.ActionPasswdChanged:
		return labels.UsersAuditPasswd
	case audit.ActionPasswdReset:
		return labels.UsersAuditReset
	default:
		// An action recorded and not named here.
		return labels.UsersAuditOther
	}
}

// auditValue turns one side of a change into a word the user reads.
//
// It is empty where the value adds nothing: the side an entry does not carry,
// the marker a password entry holds instead of the password, and the flag of a
// deactivation, which the action already states.
func auditValue(field, value string) string {
	switch {
	case value == "" || value == audit.Marker:
		return ""
	case field == auth.FieldActive:
		return ""
	case field == auth.FieldRole:
		return roleLabel(auth.Role(value))
	}
	return value
}

// roleLabel is the one place a role becomes a word the user reads.
func roleLabel(role auth.Role) string {
	if role == auth.RootRole {
		return labels.UsersRoleRoot
	}
	return labels.UsersRoleMember
}
