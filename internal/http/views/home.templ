package views

import "github.com/paveltessman/pilam/internal/http/views/ui/button"

// Home is a temporal page for testing. It exists to prove:
// templ generates, Go compiles, the server serves, and Tailwind styles it —
// including a vendored templUI component.
templ Home() {
	@Layout("pilam") {
		<main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-6 px-6">
			<div class="space-y-2">
				<p class="text-sm font-medium tracking-widest text-muted-foreground uppercase">SS27</p>
				<h1 class="text-4xl font-semibold tracking-tight">pilam</h1>
				<p class="text-muted-foreground">
					Some placeholder text.
				</p>
			</div>
			<div class="flex items-center gap-3 rounded-lg border bg-card p-4 text-card-foreground">
				<span class="size-2 rounded-full bg-emerald-500"></span>
				<span class="text-sm">Server runs!</span>
				<span class="ml-auto">
					@button.Button(button.Props{
						Href:    "/health",
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						/health
					}
				</span>
			</div>
		</main>
	}
}
