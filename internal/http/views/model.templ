package views

import (
	"github.com/paveltessman/pilam/internal/catalog"
	"github.com/paveltessman/pilam/internal/http/views/ui/button"
	"github.com/paveltessman/pilam/internal/http/views/ui/input"
	"github.com/paveltessman/pilam/internal/platform/labels"
	"github.com/paveltessman/pilam/internal/platform/media"
	"github.com/paveltessman/pilam/internal/platform/validate"
)

// ModelCard is the screen header: names one model, the photo strip, and the
// two fields the header edits.
type ModelCard struct {
	Chrome  Chrome
	ModelID string
	Article string
	Active  bool
	Season  catalog.Season
	Drop    catalog.Drop
	Photos  []ModelPhoto
	Alert   string
	Notice  string
	Errors  validate.FieldErrors
}

// Action is where the header form posts.
func (c ModelCard) Action() string { return ModelsPath + "/" + c.ModelID }

// PhotosAction is where an upload posts.
func (c ModelCard) PhotosAction() string { return c.Action() + "/photos" }

// OrderAction is where a move posts the whole strip.
func (c ModelCard) OrderAction() string { return c.PhotosAction() + "/order" }

// RemoveAction is where the remove button of one photo posts.
func (c ModelCard) RemoveAction(photo ModelPhoto) string {
	return c.PhotosAction() + "/" + photo.ID + "/remove"
}

// ModelPhoto is one photo of the strip as the card shows it: where it is
// served from, and the strip its two move buttons post.
type ModelPhoto struct {
	ID      string
	URL     string
	Cover   bool
	Earlier []string
	Later   []string
}

// NewModelStrip builds the photo strip of the card.
func NewModelStrip(photos []catalog.Photo, url func(media.Key) string) []ModelPhoto {
	strip := make([]ModelPhoto, len(photos))
	for i, photo := range photos {
		strip[i] = ModelPhoto{ID: photo.ID.String(), URL: url(photo.MediaKey), Cover: i == 0}
		if i > 0 {
			strip[i].Earlier = swapped(photos, i, i-1)
		}
		if i < len(photos)-1 {
			strip[i].Later = swapped(photos, i, i+1)
		}
	}
	return strip
}

// swapped is the strip with the photos at i and j trading places.
func swapped(photos []catalog.Photo, i, j int) []string {
	order := make([]string, len(photos))
	for at, photo := range photos {
		order[at] = photo.ID.String()
	}
	order[i], order[j] = order[j], order[i]
	return order
}

templ Model(card ModelCard) {
	{{ messages := labels.Messages(card.Errors) }}
	{{ card.Chrome.Current = labels.ModelsTitle }}
	@Page(card.Article, card.Chrome) {
		<main class="mx-auto w-full max-w-3xl px-6 py-10">
			<h1 class="mb-1 text-2xl font-semibold tracking-tight">{ card.Article }</h1>
			<p class="mb-6 text-sm text-muted-foreground">{ labels.ModelsSpineFixed }</p>
			@formAlert(card.Alert)
			@formNotice(card.Notice)
			<form method="post" action={ templ.SafeURL(card.Action()) } class="space-y-5 rounded-lg border bg-card p-6 text-card-foreground">
				<div class="grid gap-5 sm:grid-cols-2">
					@formField(fieldProps{Name: FieldModelSeason, Label: labels.ModelsSeason}) {
						@input.Input(input.Props{ID: FieldModelSeason, Value: card.Season.Name, Readonly: true})
					}
					@formField(fieldProps{Name: FieldModelDrop, Label: labels.ModelsDrop}) {
						@input.Input(input.Props{ID: FieldModelDrop, Value: card.Drop.Name, Readonly: true})
					}
				</div>
				@formField(fieldProps{
					Name:    FieldModelArticle,
					Label:   labels.ModelsArticle,
					Hint:    labels.ModelsArticleHint,
					Message: messages[FieldModelArticle],
				}) {
					@input.Input(input.Props{
						ID:         FieldModelArticle,
						Name:       FieldModelArticle,
						Value:      card.Article,
						HasError:   messages[FieldModelArticle] != "",
						Attributes: templ.Attributes{"autocomplete": "off"},
					})
				}
				@activeBox(FieldModelActive, card.Active)
				@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
					{ labels.ActionSave }
				}
			</form>
			@modelPhotos(card)
			<div class="mt-6">
				@button.Button(button.Props{Href: ModelsPath, Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ labels.ActionBackToList }
				}
			</div>
		</main>
	}
}

// modelPhotos is the strip: the upload control, and every photo with the
// buttons that move it or remove it.
templ modelPhotos(card ModelCard) {
	<section class="mt-10">
		<h2 class="mb-1 text-lg font-semibold tracking-tight">{ labels.ModelsPhotos }</h2>
		<p class="mb-4 text-sm text-muted-foreground">{ labels.ModelsPhotosHint }</p>
		<form
			method="post"
			action={ templ.SafeURL(card.PhotosAction()) }
			enctype="multipart/form-data"
			class="mb-6 flex flex-wrap items-center gap-3"
		>
			@input.Input(input.Props{
				ID:         FieldModelPhoto,
				Name:       FieldModelPhoto,
				Type:       input.TypeFile,
				FileAccept: "image/*",
				Class:      "max-w-md",
				Attributes: templ.Attributes{"multiple": true, "aria-label": labels.ModelsPhotoUpload},
			})
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				{ labels.ActionAddPhoto }
			}
		</form>
		if len(card.Photos) == 0 {
			@emptyPanel(labels.ModelsPhotosEmpty)
		} else {
			<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
				for _, photo := range card.Photos {
					@modelPhoto(card, photo)
				}
			</ul>
		}
	</section>
}

templ modelPhoto(card ModelCard, photo ModelPhoto) {
	<li class="space-y-2 rounded-lg border p-2">
		<img src={ photo.URL } alt={ labels.ModelsPhotoOf + " " + card.Article } class="aspect-square w-full rounded object-cover"/>
		if photo.Cover {
			<p class="text-center text-xs font-medium text-muted-foreground">{ labels.ModelsPhotoCover }</p>
		}
		<div class="flex items-center justify-center gap-1">
			@photoOrderForm(card, photo.Earlier, labels.ActionPhotoEarlier, "←")
			@photoOrderForm(card, photo.Later, labels.ActionPhotoLater, "→")
			<form method="post" action={ templ.SafeURL(card.RemoveAction(photo)) }>
				@button.Button(button.Props{
					Type:       button.TypeSubmit,
					Variant:    button.VariantGhost,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"aria-label": labels.ActionPhotoRemove, "title": labels.ActionPhotoRemove},
				}) {
					✕
				}
			</form>
		</div>
	</li>
}

// photoOrderForm posts the whole strip in the order this button makes. It
// renders nothing when the move has nowhere to go.
templ photoOrderForm(card ModelCard, order []string, name, arrow string) {
	if len(order) > 0 {
		<form method="post" action={ templ.SafeURL(card.OrderAction()) }>
			for _, id := range order {
				<input type="hidden" name={ FieldModelOrder } value={ id }/>
			}
			@button.Button(button.Props{
				Type:       button.TypeSubmit,
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"aria-label": name, "title": name},
			}) {
				{ arrow }
			}
		</form>
	}
}
