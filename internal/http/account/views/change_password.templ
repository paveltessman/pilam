package views

import (
	"github.com/paveltessman/pilam/internal/http/shared/ui/button"
	"github.com/paveltessman/pilam/internal/http/shared/ui/input"
	shared "github.com/paveltessman/pilam/internal/http/shared/views"
	"github.com/paveltessman/pilam/internal/platform/labels"
	"github.com/paveltessman/pilam/internal/platform/validate"
)

const (
	FieldCurrentPasswd = "current_passwd"
	FieldNewPasswd     = "new_passwd"
	FieldRepeatPasswd  = "repeat_passwd"
)

// ChangePasswordForm is what the change-password screen renders.
//
// Expired says the user is held here until the change lands, which is the state
// a first login arrives in.
type ChangePasswordForm struct {
	Expired bool
	Errors  validate.FieldErrors
}

templ ChangePassword(form ChangePasswordForm) {
	{{ messages := labels.Messages(form.Errors) }}
	@shared.Layout(labels.PasswordTitle) {
		<main class="mx-auto flex min-h-screen w-full max-w-sm flex-col justify-center px-6">
			<form
				method="post"
				action="/password"
				class="space-y-5 rounded-lg border bg-card p-6 text-card-foreground"
			>
				<h1 class="text-2xl font-semibold tracking-tight">{ labels.PasswordTitle }</h1>
				if form.Expired {
					<p
						role="alert"
						class="rounded-md border border-primary/50 px-3 py-2 text-sm"
					>
						{ labels.PasswordExpired }
					</p>
				}
				@shared.FormField(shared.FieldProps{Name: FieldCurrentPasswd, Label: labels.PasswordCurrent, Message: messages[FieldCurrentPasswd]}) {
					@passwordInput(FieldCurrentPasswd, "current-password", messages[FieldCurrentPasswd] != "", true)
				}
				@shared.FormField(shared.FieldProps{
					Name:    FieldNewPasswd,
					Label:   labels.PasswordNew,
					Hint:    labels.PasswordHint,
					Message: messages[FieldNewPasswd],
				}) {
					@passwordInput(FieldNewPasswd, "new-password", messages[FieldNewPasswd] != "", false)
				}
				@shared.FormField(shared.FieldProps{Name: FieldRepeatPasswd, Label: labels.PasswordRepeat, Message: messages[FieldRepeatPasswd]}) {
					@passwordInput(FieldRepeatPasswd, "new-password", messages[FieldRepeatPasswd] != "", false)
				}
				@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
					{ labels.ActionSave }
				}
			</form>
			<form method="post" action="/logout" class="mt-4 text-center">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
					{ labels.NavLogOut }
				}
			</form>
		</main>
	}
}

// passwordInput is one of the three inputs of this screen. They differ only in
// the name they post under, in what a password manager should do with them,
// and in whether the browser puts the cursor there when the page opens.
templ passwordInput(name, autocomplete string, hasError, autofocus bool) {
	@input.Input(input.Props{
		ID:               name,
		Name:             name,
		Type:             input.TypePassword,
		HasError:         hasError,
		NoTogglePassword: true,
		Attributes:       templ.Attributes{"autocomplete": autocomplete, "autofocus": autofocus},
	})
}
