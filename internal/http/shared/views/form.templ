package views

import (
	"github.com/paveltessman/pilam/internal/http/shared/ui/label"
	"github.com/paveltessman/pilam/internal/milestones"
	"github.com/paveltessman/pilam/internal/platform/labels"
)

// FieldProps is one input of a form, without the input itself: the label above
// it, and the one line under it.
//
// That line carries Message when the field was rejected, and Hint the rest of
// the time.
type FieldProps struct {
	Name    string
	Label   string
	Hint    string
	Message string
}

// FormField wraps one input in its label and its line.
templ FormField(f FieldProps) {
	<div class="space-y-2">
		@label.Label(label.Props{For: f.Name, Error: f.Message}) {
			{ f.Label }
		}
		{ children... }
		if f.Message != "" {
			<p class="text-sm text-destructive">{ f.Message }</p>
		} else if f.Hint != "" {
			<p class="text-sm text-muted-foreground">{ f.Hint }</p>
		}
	</div>
}

// FormAlert renders a paragraph with the 'alert' role.
templ FormAlert(text string) {
	if text != "" {
		<p role="alert" class="mb-6 rounded-md border border-destructive/50 px-3 py-2 text-sm text-destructive">
			{ text }
		</p>
	}
}

// FormNotice renders a paragraph with the 'status' role.
templ FormNotice(text string) {
	if text != "" {
		<p role="status" class="mb-6 rounded-md border border-primary/50 bg-primary/5 px-3 py-2 text-sm text-foreground">
			{ text }
		</p>
	}
}

// SelectOption is one choice of a select box: the value it posts, and the text
// the user reads.
type SelectOption struct {
	Value string
	Label string
}

// SelectGroup is a set of choices under one heading. A group with no label
// renders its choices above the headed ones, which is where a select puts the
// choice that filters nothing out.
type SelectGroup struct {
	Label   string
	Options []SelectOption
}

// SelectBox is the one select every form uses.
templ SelectBox(name string, options []SelectOption, current string, hasError bool) {
	<select id={ name } name={ name } aria-invalid?={ hasError } class={ SelectClass(hasError) }>
		for _, option := range options {
			<option value={ option.Value } selected?={ option.Value == current }>{ option.Label }</option>
		}
	</select>
}

// GroupedSelect is SelectBox with the choices under headings.
templ GroupedSelect(name string, groups []SelectGroup, current string, hasError bool) {
	<select id={ name } name={ name } aria-invalid?={ hasError } class={ SelectClass(hasError) }>
		for _, group := range groups {
			if group.Label == "" {
				for _, option := range group.Options {
					<option value={ option.Value } selected?={ option.Value == current }>{ option.Label }</option>
				}
			} else {
				<optgroup label={ group.Label }>
					for _, option := range group.Options {
						<option value={ option.Value } selected?={ option.Value == current }>{ option.Label }</option>
					}
				</optgroup>
			}
		}
	</select>
}

// SelectClass is what both selects wear, in the two states a field has.
func SelectClass(hasError bool) string {
	const shared = "flex h-9 w-full rounded-md border bg-transparent px-3 py-1 text-base shadow-xs outline-none md:text-sm"
	if hasError {
		return shared + " border-destructive"
	}
	return shared + " border-input focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"
}

// ActiveBox is the flag a catalog record carries.
templ ActiveBox(name string, checked bool) {
	<label class="flex items-center gap-2 text-sm font-medium">
		<input
			type="checkbox"
			id={ name }
			name={ name }
			value="true"
			checked?={ checked }
			class="size-4 rounded border border-input accent-primary"
		/>
		{ labels.StateActive }
	</label>
}

// MilestoneState is the word one state of a step reads as. The calendar section
// of the model card and the milestone list both read it.
func MilestoneState(state milestones.State) string {
	switch state {
	case milestones.StateDone:
		return labels.MilestonesStateDone
	case milestones.StateLate:
		return labels.MilestonesStateLate
	case milestones.StateDue:
		return labels.MilestonesStateDue
	case milestones.StatePlanned:
		return labels.MilestonesStatePlanned
	}
	// A state computed and not named here.
	return labels.Empty
}

// StateCell is the `active` flag as a list column reads it.
templ StateCell(active bool) {
	if active {
		<span class="text-muted-foreground">{ labels.StateActive }</span>
	} else {
		<span class="text-destructive">{ labels.StateInactive }</span>
	}
}

// EmptyPanel is what a list shows in place of a table it has no rows for.
templ EmptyPanel(text string) {
	<div class="rounded-lg border border-dashed p-12 text-center text-muted-foreground">
		<p>{ text }</p>
	</div>
}
