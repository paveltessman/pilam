# The production environment, rendered by CI on every deploy.
#
# This file is committed. GitHub Actions fills the two
# placeholders below from repository secrets, then writes the result to
# /srv/pilam/.env on the server. See .github/workflows/deploy.yml.
#
# Variables are parsed and validated in internal/platform/config. A name that
# appears here but not there is ignored. A bad value fails the process at
# startup rather than at first use.
#

# --- app --------------------------------------------------------------------
# The loopback port Caddy proxies to. The app inside the container always
# listens on 8080.
HTTP_PORT=8081

# How long in-flight requests get to finish after SIGTERM.
HTTP_SHUTDOWN_GRACE=15s

# The timezone the business runs on.
# Must be an IANA name. "Local" is rejected.
BUSINESS_TZ=Europe/Moscow

# --- session ----------------------------------------------------------------
# From the SESSION_SECRET repository secret. At least 32 characters. If it is
# ever empty the app makes a key at boot, and every deploy logs every user out.
SESSION_SECRET=${SESSION_SECRET}

# How long a login lasts.
SESSION_TTL=168h

# --- logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_FORMAT=json

# --- postgres ---------------------------------------------------------------
# From the POSTGRES_PASSWORD repository secret.
#
# Postgres bakes this into the data volume the first time the stack starts.
# Changing the secret alone does NOT change the running database, and the app
# then fails to connect. docs/v1/deploy.md says how to rotate it properly.
POSTGRES_USER=pilam
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=pilam

# The password is percent-encoded, because a URL gives @ : / ? and # a meaning
# of their own. The renderer derives this placeholder from POSTGRES_PASSWORD.
DATABASE_URL=postgres://pilam:${POSTGRES_PASSWORD_URLENC}@db:5432/pilam?sslmode=disable

# --- media ------------------------------------------------------------------
# Where uploaded photos are written inside the container. Backed by the `media`
# named volume. Change this only together with the mount in
# docker-compose.prod.yml.
MEDIA_DIR=/var/lib/pilam/media
